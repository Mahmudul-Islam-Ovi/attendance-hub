# PostgreSQL (matches docker-compose.yml). For Supabase paste its connection string here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance?schema=public"

# Demo login: no auth in this version, the app acts as this employee.
DEMO_USER_EMAIL="habib@office.test"

# Timezone used for "today", late calculation and time display.
NEXT_PUBLIC_APP_TZ="Asia/Dhaka"

# Secret for biometric / RFID / face devices calling /api/attendance/device
DEVICE_API_KEY="change-me-device-key"

# Office geofence used by the seed. Set these to YOUR current coordinates to test GPS punch.
SEED_OFFICE_LAT="23.7330"
SEED_OFFICE_LNG="90.4172"
SEED_OFFICE_RADIUS="200"
